{
  "name": "design-daas-e2e",
  "version": "2.0.0",
  "description": "End-to-end tests for the DESIGN DaaS stack",
  "scripts": {
    "test": "playwright test",
    "test:public": "playwright test --project=public",
    "test:user": "playwright test --project=user",
    "test:admin": "playwright test --project=admin",
    "test:session": "playwright test --project=session",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  },
  "private": "true"
}
