# Copy to .env and fill in. .env is git-ignored; never commit real passwords.

# Frontend URL as the browser opens it. Use the same host name the frontend
# was built for (FRONTEND_PUBLIC_URL in design-daas/installer/daas.env),
# otherwise the auth service rejects the login request (CORS, HTTP 403).
E2E_BASE_URL=https://front0.cluster.local:8443

# Accept the self-signed certificate of the local nginx (true/false).
E2E_IGNORE_HTTPS_ERRORS=true

# Test accounts. Tests that need a login are skipped while these are empty.
# The admin is e.g. ADMIN_EMAIL / ADMIN_PASSWORD from daas.env (bootstrap admin).
E2E_USER_USERNAME=
E2E_USER_PASSWORD=
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Opt-in: really start and stop a VM/container object of the test user.
# Takes minutes and uses resources, so it is off by default.
E2E_ALLOW_START_STOP=false
# Value of the object in the "Available objects" list (id_object); empty = first one.
E2E_OBJECT_ID=
# Max time for the start of an object, in seconds.
E2E_START_TIMEOUT=600

# DaaS container object for the admin Docker page (e.g. contx11): inspected,
# and with E2E_ALLOW_START_STOP cloned into a temporary object that is built,
# started, stopped and deleted again. Empty = those tests are skipped.
E2E_CONTAINER_ID=
